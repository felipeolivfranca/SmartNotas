# Copie este arquivo para .env e preencha a chave.
# Como gerar: https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=

# Modelo usado para ler as notas. Troque livremente para comparar custo x precisão.
# Preços por milhão de tokens (entrada / saída), sempre confira em
# https://ai.google.dev/gemini-api/docs/pricing — há também um tier gratuito.
#   gemini-3.7-flash       -> geração mais nova, melhor leitura em cupom ruim  (US$ 0,75 / 3,75)
#   gemini-3.5-flash-lite  -> o mais barato e rápido, erra mais em letra miúda (US$ 0,30 / 2,50)
#   gemini-2.5-pro         -> raciocínio profundo, mais caro e mais lento      (US$ 1,25 / 10,00)
SMARTNOTAS_MODEL=gemini-3.7-flash

# Opcional: sobrescreve o SQLite padrão (backend/data/smartnotas.db)
# DATABASE_URL=sqlite:///C:/caminho/para/smartnotas.db
